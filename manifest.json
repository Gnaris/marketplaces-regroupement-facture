{
  "manifest_version": 3,
  "name": "Marketplaces Regroupement Facture",
  "version": "3.27.0",
  "permissions": ["storage"],
  "description": "Regroupe les articles d'une commande par catégorie et prix unitaire — Paris Fashion Shop + Efashion Paris + Ankorstore + Faire + Microstore + Orderchamp + Shopify + Beli & Jolie + Bijoux Mystères + Issyma. Génère aussi des bordereaux Easy-Express et crée les factures provisoires dans Sage 50 (via SageBridge).",
  "host_permissions": [
    "https://wholesaler.parisfashionshops.com/*",
    "https://wholesaler-api.parisfashionshops.com/*",
    "https://wholesaler.efashion-paris.com/*",
    "https://wapi.efashion-paris.com/*",
    "https://*.ankorstore.com/*",
    "https://www.faire.com/*",
    "https://web.mc.app/*",
    "https://*.dokkr.net/*",
    "https://www.orderchamp.com/*",
    "https://admin.shopify.com/*",
    "https://beliandjolie.com/*",
    "https://www.beliandjolie.com/*",
    "https://www.bijouxmysteres.fr/*",
    "https://server.bijouxmysteres.fr/*",
    "https://issyma.fr/*",
    "https://www.issyma.fr/*",
    "https://easy-express.fr/*",
    "https://recherche-entreprises.api.gouv.fr/*",
    "https://ec.europa.eu/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Easy-Express — Générer un bordereau",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wholesaler.parisfashionshops.com/orders/*/details*",
        "https://wholesaler.efashion-paris.com/orderdetails/*",
        "https://*.ankorstore.com/account/orders/*",
        "https://www.faire.com/brand-portal/orders/*",
        "https://www.orderchamp.com/*/backoffice/orders/*",
        "https://admin.shopify.com/store/*/orders/*",
        "https://beliandjolie.com/admin/commandes/*",
        "https://www.beliandjolie.com/admin/commandes/*",
        "https://www.bijouxmysteres.fr/admin/commandes/*",
        "https://issyma.fr/admin/commandes/*",
        "https://www.issyma.fr/admin/commandes/*",
        "http://localhost:3000/admin/commandes/*"
      ],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.mc.app/*",
        "https://mc2-h5.dokkr.net/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://wholesaler.parisfashionshops.com/*"]
    },
    {
      "resources": ["injected-mc.js"],
      "matches": ["https://web.mc.app/*", "https://*.dokkr.net/*"]
    },
    {
      "resources": ["injected-faire.js"],
      "matches": ["https://www.faire.com/*"]
    },
    {
      "resources": ["injected-shopify.js"],
      "matches": ["https://admin.shopify.com/*"]
    },
    {
      "resources": ["injected-bm.js"],
      "matches": ["https://www.bijouxmysteres.fr/*"]
    },
    {
      "resources": ["z.png", "img1.png", "img2.png", "img3.png", "img4.png", "img5.png", "img6.png"],
      "matches": [
        "https://wholesaler.parisfashionshops.com/*",
        "https://wholesaler.efashion-paris.com/*",
        "https://*.ankorstore.com/*",
        "https://www.faire.com/*",
        "https://web.mc.app/*",
        "https://*.dokkr.net/*",
        "https://www.orderchamp.com/*",
        "https://admin.shopify.com/*",
        "https://beliandjolie.com/*",
        "https://www.beliandjolie.com/*",
        "https://www.bijouxmysteres.fr/*",
        "https://issyma.fr/*",
        "https://www.issyma.fr/*",
        "http://localhost:3000/*"
      ]
    }
  ]
}
